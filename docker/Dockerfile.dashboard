FROM python:3.12-slim

LABEL maintainer="Hermes Multi-Agent System"
LABEL description="Dashboard web para administrar múltiples agentes de Hermes"

# Establecer directorio de trabajo
WORKDIR /app

# Instalar dependencias del sistema
RUN apt-get update && apt-get install -y \
    curl \
    git \
    ssh-client \
    rsync \
    && rm -rf /var/lib/apt/lists/*

# Copiar requirements
COPY requirements.txt .

# Instalar dependencias de Python
RUN pip install --no-cache-dir -r requirements.txt

# Copiar código de la aplicación
COPY hermes_multi_agent_dashboard.py .
COPY templates/ ./templates/

# Crear directorio de configuración
RUN mkdir -p /app/config /app/logs /app/data

# Exponer puertos
EXPOSE 5000

# Variables de entorno
ENV FLASK_APP=hermes_multi_agent_dashboard.py
ENV FLASK_ENV=production
ENV PYTHONUNBUFFERED=1

# Crear usuario no-root para seguridad
RUN useradd -m -u 1000 hermes && \
    chown -R hermes:hermes /app

USER hermes

# Comando de inicio
CMD ["python", "hermes_multi_agent_dashboard.py"]
