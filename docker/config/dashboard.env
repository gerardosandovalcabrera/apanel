# APanel Configuration File
# ==========================================
# This file contains all configuration for APanel
# ==========================================

# Database Configuration
# ==========================================
DATABASE_URL=postgresql://apanel:apanel_password@postgres:5432/apanel_db
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=apanel_db
DATABASE_USER=apanel
DATABASE_PASSWORD=apanel_password

# Redis Configuration
# ==========================================
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# Application Configuration
# ==========================================
APP_NAME=APanel
APP_ENV=production
DEBUG=false
FLASK_ENV=production

# Security Configuration
# ==========================================
DASHBOARD_SECRET_KEY=change-this-to-a-secure-random-key
JWT_SECRET_KEY=change-this-to-a-secure-random-key
JWT_EXPIRATION_HOURS=24
ENCRYPTION_KEY=change-this-to-a-secure-random-key
API_KEY=change-this-to-a-secure-random-key

# Ports Configuration
# ==========================================
FLASK_PORT=5000
NGINX_PORT=80
NGINX_SSL_PORT=443

# Logging Configuration
# ==========================================
LOG_LEVEL=INFO
LOG_DIR=/app/logs

# OAuth Configuration (Optional)
# ==========================================
# OAuth GitHub
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GITHUB_REDIRECT_URI=http://localhost:5000/auth/github/callback

# OAuth Google
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback

# Billing Configuration
# ==========================================
BILLING_ENABLED=true
COST_TRACKING_ENABLED=true
BUDGET_ALERTS_ENABLED=true
DEFAULT_CURRENCY=USD

# Plan Configuration
# ==========================================
DEFAULT_PLAN_TIER=free
PLAN_CHECK_INTERVAL=60  # seconds

# Backup Configuration
# ==========================================
BACKUP_ENABLED=true
BACKUP_INTERVAL=3600  # seconds (1 hour)
BACKUP_RETENTION_DAYS=30
